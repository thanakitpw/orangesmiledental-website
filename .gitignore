# Compressed media staging. Not needed in the repo: the site serves images from
# Supabase Storage, and this dir is regenerated by `npm run media:prepare`.
/public/media

# The original design handoff (~475 MB of raw source images + the .dc.html files).
# Everything in it has been ported to src/ and its images are compressed and
# uploaded to Supabase, so it is kept out of the repo. Keep a local/Drive copy —
# it is the only input `npm run media:prepare` needs if media ever has to be rebuilt.
/Website creation request/

# Content drops from the clinic, same reasoning: they are an input to the port,
# not part of the site. Git stores binaries whole on every change, so a 13 MB zip
# is 13 MB in every future clone — permanently, even after it is deleted.
*.zip
.vercel
.env*
!.env.example
